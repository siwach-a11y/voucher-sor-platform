# Postgres (packages/db)
DATABASE_URL="postgresql://voucher:voucher@localhost:5432/voucher_sor?schema=public"

# Redis (BullMQ queues, apps/api + apps/worker)
REDIS_URL="redis://localhost:6379"

# apps/api
API_PORT=4000
JWT_SECRET="change-me"

# apps/web
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# apps/worker — crawler cadence in minutes, per the "5-15 minute, configurable" spec
CRAWL_INTERVAL_MINUTES=10
SCORING_RECALC_INTERVAL_MINUTES=5

# Payment tokenization provider (never store raw card numbers — see docs/ARCHITECTURE.md § Payment Logic)
PAYMENT_PROVIDER_API_KEY=""

# Notification channel used to pause-and-notify on OTP/3-D Secure (see execution-router.ts)
USER_APPROVAL_WEBHOOK_URL=""
