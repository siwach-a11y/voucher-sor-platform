# EXAMPLE ONLY — copy to secret.yaml, fill in real values out-of-band (e.g. via `kubectl create
# secret` from a vault/CI pipeline), and NEVER commit the filled-in file. Values below are
# placeholders, not real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: voucher-sor-secrets
  namespace: voucher-sor
type: Opaque
stringData:
  DATABASE_URL: "postgresql://voucher:CHANGE_ME@postgres-service:5432/voucher_sor?schema=public"
  POSTGRES_PASSWORD: "CHANGE_ME"
  JWT_SECRET: "CHANGE_ME"
  PAYMENT_PROVIDER_API_KEY: "CHANGE_ME"
  USER_APPROVAL_WEBHOOK_URL: "https://example.com/webhooks/user-approval"
