{
  "name": "@voucher-sor/framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Vendor-agnostic Smart Order Routing framework for browser-automation purchase execution. Contains no vendor implementations — see src/connectors/README.md.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "test": "vitest run"
  },
  "dependencies": {
    "playwright": "^1.46.0",
    "js-yaml": "^4.1.0",
    "@voucher-sor/logger": "*"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
